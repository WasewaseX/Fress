!.env.example

# Signing key material must never enter the public repository. The Android
# keystore is generated and stored outside the repo (repository secret
# ANDROID_KEYSTORE_B64 + private backup); a stray local keystore file in the
# working tree must be impossible to commit by accident.
*.keystore
*.jks
*.pfx
*.pem
*.key

# Playwright run artifacts (reports, traces, results) are workflow outputs,
# not sources. The visual BASELINES in tests/e2e/z-visual.spec.ts-snapshots/
# ARE sources and stay versioned - they are the visual contract.
test-results/
playwright-report/
playwright-live-report/
scripts/perf/results/
