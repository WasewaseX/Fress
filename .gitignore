node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/
coverage/
.DS_Store
*.log
.env
.env.*
!.env.example

# Signing key material must never enter the public repository. The Android
# keystore is generated and stored outside the repo (repository secret
# ANDROID_KEYSTORE_B64 + private backup); a stray local keystore file in the
# working tree must be impossible to commit by accident.
*.keystore
*.jks
*.pfx
*.pem
*.key

# QA tooling outputs (Agent 6): Playwright run artifacts and perf results are
# attached as CI artifacts, never committed.
test-results/
playwright-report/
playwright-live-report/
scripts/perf/results/

# Agent QA captures (screenshots + measurement reports) stay local;
# the durable visual regression baselines live in tests/e2e/*-snapshots/.
qa-shots/

# Tauri generates src-tauri/gen (android studio project, schemas) per
# machine and CI regenerates it on every release build (release.yml runs
# `tauri android init`). The Android-native pieces this app needs at build
# time (FileProvider scope, FressFileOpenerPlugin.kt) are re-applied after
# generation by scripts/patch-android-fileprovider.mjs - see
# docs/android-open-path-interface.md.
/src-tauri/gen/
