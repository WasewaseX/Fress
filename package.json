{
  "name": "fress",
  "private": true,
  "version": "1.0.11-beta",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "validate:security": "node scripts/validate-security-config.mjs",
    "validate:versions": "tsx scripts/ci/validate-versions.ts",
    "perf:catalog": "tsx scripts/perf-catalog.ts",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build && playwright test",
    "test:visual": "playwright test tests/e2e/z-visual.spec.ts",
    "test:perf": "tsx scripts/perf/catalog-perf.ts",
    "test:live": "playwright test --config=playwright.live.config.ts",
    "clean": "rm -rf dist",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
