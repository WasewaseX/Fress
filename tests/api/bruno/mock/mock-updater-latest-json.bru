meta {
  name: M5 updater chain (mock)
  type: http
  seq: 15
}

get {
  url: {{mockBase}}/updater/latest.json
  body: none
  auth: none
}

script:post-response {
  const raw = typeof res.body === 'function' ? res.body() : res.body;
  const doc = raw && typeof raw === 'object' ? raw : JSON.parse(raw || 'null');
  if (!/^\d+\.\d+\.\d+$/.test(doc.version || '')) {
    throw new Error('latest.json version is not semver: ' + doc.version);
  }
  const keys = Object.keys(doc.platforms || {});
  if (keys.length < 8) throw new Error('latest.json carries ' + keys.length + ' platforms');
  for (const k of keys) {
    if (!doc.platforms[k].signature || !doc.platforms[k].url) {
      throw new Error('platform ' + k + ' is missing signature or url');
    }
  }
}

tests {
  test("updater manifest answers 200", function() {
    expect(res.status).to.eql(200);
  });
}
